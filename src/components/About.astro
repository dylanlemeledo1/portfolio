---
import { SITE } from '../data/site';
import { useTranslations, assetUrl } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  /** 'h1' quand About est le titre principal de la page (ex: /parcours),
   *  'h2' (defaut) quand il suit un h1 deja present (ex: le Hero de l'accueil). */
  headingLevel?: 'h1' | 'h2';
}
const { lang, headingLevel = 'h2' } = Astro.props;
const t = useTranslations(lang);
const Heading = headingLevel;
---

<section id="about" class="section" aria-labelledby="about-title">
  <div class="container about-grid">
    <div class="about-text reveal">
      <p class="kicker">{t('about.kicker')}</p>
      <Heading id="about-title" class="section-title">{t('about.title')}</Heading>
      <p class="about-p">{t('about.p1')}</p>
      <p class="about-p">{t('about.p2')}</p>
      <p class="about-p">{t('about.p3')}</p>

      <p class="about-location">
        <Icon name="location" />
        <span>{SITE.location}</span>
      </p>
    </div>

    <aside class="about-card reveal" aria-label={t('about.title')}>
      {
        SITE.photoUrl ? (
          <img
            class="avatar avatar-photo"
            src={assetUrl(SITE.photoUrl)}
            alt={SITE.name}
            width="160"
            height="160"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="avatar" aria-hidden="true">
            {SITE.initials}
          </div>
        )
      }
      <p class="about-name">{SITE.name}</p>
      <p class="about-job">{t('hero.role')}</p>
      <hr />
      <dl class="about-facts">
        <div>
          <dt>Email</dt>
          <dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
        </div>
        <div>
          <dt>{lang === 'fr' ? 'Localisation' : 'Location'}</dt>
          <dd>{SITE.location}</dd>
        </div>
      </dl>
    </aside>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: clamp(2rem, 1rem + 4vw, 4rem);
    align-items: start;
  }
  .about-p {
    color: var(--text-muted);
    margin-bottom: 1rem;
    max-width: 60ch;
  }
  .about-location {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
    color: var(--text-muted);
    font-weight: 500;
  }
  .about-location :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--accent);
  }

  .about-card {
    position: sticky;
    top: 6rem;
    padding: 2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-soft);
    box-shadow: var(--shadow);
    text-align: center;
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 5rem;
    height: 5rem;
    margin: 0 auto 1rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-contrast);
    font-size: var(--step-2);
    font-weight: 800;
  }
  .avatar-photo {
    display: block;
    object-fit: cover;
    object-position: center top;
    border: 2px solid var(--border);
  }
  .about-name {
    font-weight: 700;
    font-size: var(--step-1);
  }
  .about-job {
    color: var(--text-muted);
  }
  .about-card hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 1.25rem 0;
  }
  .about-facts {
    text-align: left;
    display: grid;
    gap: 0.85rem;
  }
  .about-facts dt {
    font-size: var(--step--1);
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .about-facts dd {
    font-weight: 500;
    word-break: break-word;
  }
  .about-facts a {
    color: var(--text);
    text-decoration: none;
  }
  .about-facts a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  @media (max-width: 56rem) {
    .about-grid {
      grid-template-columns: 1fr;
    }
    .about-card {
      position: static;
    }
  }
</style>
