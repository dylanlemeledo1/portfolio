---
import { PROJECTS } from '../data/site';
import { useTranslations, assetUrl } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  headingLevel?: 'h1' | 'h2';
}
const { lang, headingLevel = 'h2' } = Astro.props;
const t = useTranslations(lang);
const Heading = headingLevel;
---

<section id="projects" class="section" aria-labelledby="projects-title">
  <div class="container">
    <header class="reveal">
      <p class="kicker">{t('projects.kicker')}</p>
      <Heading id="projects-title" class="section-title">{t('projects.title')}</Heading>
      <p class="section-subtitle">{t('projects.subtitle')}</p>
    </header>

    <div class="projects-grid">
      {
        PROJECTS.map((p) => (
          <article class:list={['project-card', 'reveal', { featured: p.featured }]}>
            <div class="project-top">
              <span class="project-icon" aria-hidden="true">
                <Icon name="code" />
              </span>
              <h3 class="project-title">{p.title}</h3>
            </div>

            <p class="project-desc">{p[lang].description}</p>

            <ul class="project-tech" role="list" aria-label={t('projects.tech')}>
              {p.tech.map((tech) => (
                <li>{tech}</li>
              ))}
            </ul>

            <div class="project-links">
              {p.repo && (
                <a
                  class="project-link"
                  href={p.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <Icon name="github" />
                  <span>{t('projects.code')}</span>
                  <span class="visually-hidden">— {p.title}</span>
                </a>
              )}
              {p.demo && (
                <a
                  class="project-link"
                  href={p.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <Icon name="external" />
                  <span>{t('projects.demo')}</span>
                  <span class="visually-hidden">— {p.title}</span>
                </a>
              )}
              {p.play && (
                <button
                  type="button"
                  class="project-link project-play-btn"
                  data-play-trigger
                  data-play-src={assetUrl(p.play)}
                  data-play-title={p.title}
                >
                  <Icon name="external" />
                  <span>{t('projects.play')}</span>
                  <span class="visually-hidden">— {p.title}</span>
                </button>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <dialog id="project-play-dialog" class="play-dialog" aria-label={t('projects.play')}>
    <div class="play-dialog-head">
      <p class="play-dialog-title" data-play-dialog-title></p>
      <div class="play-dialog-actions">
        <a
          class="play-fullscreen-link"
          data-play-fullscreen-link
          href="#"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="external" />
          <span>{t('projects.playFullscreen')}</span>
        </a>
        <button type="button" class="play-dialog-close" data-play-close aria-label={t('projects.playClose')}>
          <Icon name="close" />
        </button>
      </div>
    </div>
    <iframe
      id="project-play-frame"
      class="play-iframe"
      title={t('projects.play')}
      loading="lazy"
      allow="autoplay; fullscreen"
    ></iframe>
  </dialog>
</section>

<script is:inline>
  (function () {
    const dialog = document.getElementById('project-play-dialog');
    const frame = document.getElementById('project-play-frame');
    if (!dialog || !frame) return;
    const titleEl = dialog.querySelector('[data-play-dialog-title]');
    const closeBtn = dialog.querySelector('[data-play-close]');
    const fullscreenLink = dialog.querySelector('[data-play-fullscreen-link]');

    document.querySelectorAll('[data-play-trigger]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const src = btn.getAttribute('data-play-src');
        const title = btn.getAttribute('data-play-title') || '';
        if (!src) return;
        frame.src = src;
        if (titleEl) titleEl.textContent = title;
        if (fullscreenLink) fullscreenLink.setAttribute('href', src);
        dialog.showModal();
      });
    });

    function closeDialog() {
      dialog.close();
      frame.src = 'about:blank';
    }

    closeBtn?.addEventListener('click', closeDialog);
    dialog.addEventListener('cancel', () => {
      frame.src = 'about:blank';
    });
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) closeDialog();
    });
  })();
</script>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: 1.5rem;
  }
  .project-card {
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    transition: border-color var(--transition), transform var(--transition),
      box-shadow var(--transition);
  }
  .project-card:hover {
    border-color: var(--accent);
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  /* Le projet "featured" prend 2 colonnes sur grand ecran */
  .project-card.featured {
    grid-column: span 1;
  }
  @media (min-width: 60rem) {
    .project-card.featured {
      grid-column: span 2;
    }
  }

  .project-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .project-icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
    color: var(--accent);
  }
  .project-icon :global(svg) {
    width: 1.3rem;
    height: 1.3rem;
  }
  .project-title {
    font-size: var(--step-1);
  }
  .project-desc {
    color: var(--text-muted);
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1.5rem;
  }
  .project-tech li {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm);
    background: var(--bg-soft);
    color: var(--text-muted);
    border: 1px solid var(--border);
  }

  .project-links {
    display: flex;
    gap: 1.25rem;
    margin-top: auto;
  }
  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
    font-size: var(--step--1);
  }
  .project-link :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }
  .project-link:hover {
    color: var(--accent);
  }

  .project-play-btn {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: inherit;
  }

  /* ---- Lightbox jeu jouable ---- */
  .play-dialog {
    width: min(94vw, 68rem);
    height: min(90vh, 50rem);
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    color: var(--text);
    overflow: hidden;
  }
  .play-dialog::backdrop {
    background: rgba(0, 0, 0, 0.72);
    backdrop-filter: blur(2px);
  }
  .play-dialog[open] {
    display: flex;
    flex-direction: column;
  }
  .play-dialog-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg-soft);
  }
  .play-dialog-title {
    font-weight: 700;
    font-size: var(--step--1);
  }
  .play-dialog-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .play-fullscreen-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-muted);
    text-decoration: none;
    font-size: var(--step--1);
    font-weight: 600;
  }
  .play-fullscreen-link:hover {
    color: var(--accent);
  }
  .play-fullscreen-link :global(svg) {
    width: 1rem;
    height: 1rem;
  }
  .play-dialog-close {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: none;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }
  .play-dialog-close:hover {
    background: var(--bg);
    color: var(--accent);
  }
  .play-dialog-close :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
  }
  .play-iframe {
    flex: 1;
    width: 100%;
    border: none;
    background: #06061a;
  }
</style>
