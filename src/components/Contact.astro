---
import { SITE } from '../data/site';
import { useTranslations, assetUrl } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const hasFormspree = SITE.formspreeId !== 'YOUR_FORM_ID' && SITE.formspreeId !== '';
const action = hasFormspree ? `https://formspree.io/f/${SITE.formspreeId}` : '';
---

<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="container section-narrow contact-wrap">
    <header class="reveal contact-head">
      <p class="kicker">{t('contact.kicker')}</p>
      <h2 id="contact-title" class="section-title">{t('contact.title')}</h2>
      <p class="section-subtitle">{t('contact.subtitle')}</p>
    </header>

    <form
      class="contact-form reveal"
      action={action}
      method="POST"
      data-contact-form
      data-email={SITE.email}
      data-lang={lang}
      novalidate
    >
      <div class="field">
        <label for="cf-name">
          {t('contact.name')} <span class="req" aria-hidden="true">*</span>
        </label>
        <input
          id="cf-name"
          name="name"
          type="text"
          autocomplete="name"
          required
          aria-required="true"
          placeholder={t('contact.namePlaceholder')}
        />
      </div>

      <div class="field">
        <label for="cf-email">
          {t('contact.email')} <span class="req" aria-hidden="true">*</span>
        </label>
        <input
          id="cf-email"
          name="email"
          type="email"
          autocomplete="email"
          required
          aria-required="true"
          placeholder={t('contact.emailPlaceholder')}
        />
      </div>

      <div class="field">
        <label for="cf-message">
          {t('contact.message')} <span class="req" aria-hidden="true">*</span>
        </label>
        <textarea
          id="cf-message"
          name="message"
          rows="5"
          required
          aria-required="true"
          placeholder={t('contact.messagePlaceholder')}></textarea>
      </div>

      <!-- Anti-spam : champ cache (honeypot) -->
      <div class="hp" aria-hidden="true">
        <label for="cf-website">Ne pas remplir</label>
        <input id="cf-website" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <button type="submit" class="btn btn-primary contact-submit" data-submit>
        <span data-submit-label>{t('contact.send')}</span>
        <Icon name="arrowRight" />
      </button>

      <!-- Zone d'annonce pour lecteurs d'ecran + visuel -->
      <p
        class="form-status"
        data-status
        role="status"
        aria-live="polite"
        hidden
      >
      </p>

      <p class="contact-alt">
        {t('contact.orEmail')}
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </p>

      {
        SITE.cvUrl && (
          <a
            class="btn btn-secondary cv-btn"
            href={assetUrl(SITE.cvUrl)}
            download
          >
            <Icon name="download" />
            {t('contact.downloadCv')}
          </a>
        )
      }
    </form>
  </div>
</section>

<script
  is:inline
  define:vars={{
    successMsg: t('contact.success'),
    errorMsg: t('contact.error'),
    sendingMsg: t('contact.sending'),
    sendLabel: t('contact.send'),
  }}
>
  (function () {
    const form = document.querySelector('[data-contact-form]');
    if (!form) return;
    const status = form.querySelector('[data-status]');
    const submitBtn = form.querySelector('[data-submit]');
    const submitLabel = form.querySelector('[data-submit-label]');
    const action = form.getAttribute('action');
    const email = form.getAttribute('data-email');

    function showStatus(msg, ok) {
      status.hidden = false;
      status.textContent = msg;
      status.classList.toggle('is-success', ok);
      status.classList.toggle('is-error', !ok);
    }

    form.addEventListener('submit', async function (e) {
      e.preventDefault();

      // Validation HTML native + focus sur le 1er champ invalide
      if (!form.checkValidity()) {
        const firstInvalid = form.querySelector(':invalid');
        if (firstInvalid) firstInvalid.focus();
        form.reportValidity();
        return;
      }

      const data = new FormData(form);

      // Pas d'ID Formspree configure -> on bascule sur un email pre-rempli
      if (!action) {
        const subject = encodeURIComponent('Contact portfolio — ' + data.get('name'));
        const body = encodeURIComponent(
          data.get('message') + '\n\n— ' + data.get('name') + ' (' + data.get('email') + ')'
        );
        window.location.href =
          'mailto:' + email + '?subject=' + subject + '&body=' + body;
        return;
      }

      submitBtn.disabled = true;
      submitLabel.textContent = sendingMsg;

      try {
        const res = await fetch(action, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });
        if (res.ok) {
          showStatus(successMsg, true);
          form.reset();
        } else {
          showStatus(errorMsg, false);
        }
      } catch (err) {
        showStatus(errorMsg, false);
      } finally {
        submitBtn.disabled = false;
        submitLabel.textContent = sendLabel;
      }
    });
  })();
</script>

<style>
  .contact-wrap {
    text-align: center;
  }
  .contact-head {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .contact-head .section-subtitle {
    text-align: center;
    max-width: 46ch;
  }

  .contact-form {
    text-align: left;
    display: grid;
    gap: 1.1rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-soft);
  }

  .field {
    display: grid;
    gap: 0.4rem;
  }
  .field label {
    font-weight: 600;
    font-size: var(--step--1);
  }
  .req {
    color: var(--error);
  }

  input,
  textarea {
    width: 100%;
    padding: 0.75rem 0.9rem;
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--text);
    transition: border-color var(--transition), box-shadow var(--transition);
    resize: vertical;
  }
  input::placeholder,
  textarea::placeholder {
    color: var(--text-faint);
  }
  input:focus-visible,
  textarea:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 25%, transparent);
  }
  input:user-invalid,
  textarea:user-invalid {
    border-color: var(--error);
  }

  /* Honeypot : invisible pour les humains, visible pour les bots */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .contact-submit {
    justify-self: start;
    margin-top: 0.25rem;
  }

  .form-status {
    margin: 0;
    padding: 0.85rem 1rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
  }
  .form-status.is-success {
    background: color-mix(in srgb, var(--success) 14%, transparent);
    color: var(--success);
    border: 1px solid color-mix(in srgb, var(--success) 40%, transparent);
  }
  .form-status.is-error {
    background: color-mix(in srgb, var(--error) 12%, transparent);
    color: var(--error);
    border: 1px solid color-mix(in srgb, var(--error) 40%, transparent);
  }

  .contact-alt {
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .contact-alt a {
    color: var(--accent);
    font-weight: 600;
  }

  .cv-btn {
    justify-self: start;
  }
</style>
