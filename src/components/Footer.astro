---
import { SITE, SOCIALS } from '../data/site';
import { useTranslations, homeUrl } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a class="logo" href={homeUrl(lang)} aria-label={SITE.name}>
        <span class="logo-mark" aria-hidden="true">{SITE.initials}</span>
        <span>{SITE.name}</span>
      </a>
      <p class="footer-tag">{t('hero.role')}</p>
    </div>

    <ul class="footer-socials" role="list">
      {
        SOCIALS.map((s) => (
          <li>
            <a
              class="icon-btn"
              href={s.url}
              aria-label={s.name}
              title={s.name}
              {...(s.icon !== 'mail'
                ? { target: '_blank', rel: 'noopener noreferrer' }
                : {})}
            >
              <Icon name={s.icon} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="container footer-bottom">
    <p class="footer-copy">
      © {year} {SITE.name}. {t('footer.rights')}
    </p>
    <p class="footer-built">
      {t('footer.builtwith')} <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>
    </p>
    <a class="back-top" href="#main" aria-label={t('footer.backtotop')}>
      <span>{t('footer.backtotop')}</span>
      <Icon name="arrowUp" />
    </a>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--bg-soft);
    padding-block: clamp(2.5rem, 1.5rem + 3vw, 4rem) 1.75rem;
    margin-top: var(--section-gap);
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--text);
    font-weight: 700;
  }
  .logo-mark {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 8px;
    background: var(--text);
    color: var(--bg);
    font-size: 0.75rem;
    font-weight: 800;
  }
  .footer-tag {
    color: var(--text-muted);
    font-size: var(--step--1);
    margin-top: 0.35rem;
  }
  .footer-socials {
    display: flex;
    gap: 0.6rem;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 1.5rem;
    color: var(--text-faint);
    font-size: var(--step--1);
  }
  .footer-built a {
    color: var(--text-muted);
    font-weight: 600;
  }
  .back-top {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 600;
  }
  .back-top:hover {
    color: var(--accent);
  }
  .back-top :global(svg) {
    width: 1rem;
    height: 1rem;
  }
</style>
