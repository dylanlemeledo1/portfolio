---
import { SITE } from '../data/site';
import { useTranslations, homeUrl, alternateUrl, pageUrl } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const navLinks = [
  { href: pageUrl(lang, 'parcours'), label: t('nav.parcours') },
  { href: pageUrl(lang, 'stage'), label: t('nav.stage') },
  { href: pageUrl(lang, 'projets'), label: t('nav.projects') },
  { href: pageUrl(lang, 'competences'), label: t('nav.competences') },
  { href: pageUrl(lang, 'veille'), label: t('nav.veille') },
  { href: pageUrl(lang, 'autoeval'), label: t('nav.autoeval') },
  { href: `${homeUrl(lang)}#contact`, label: t('nav.contact') },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href={homeUrl(lang)} aria-label={SITE.name}>
      <span class="logo-mark" aria-hidden="true">{SITE.initials}</span>
      <span class="logo-name">{SITE.name}</span>
    </a>

    <nav class="nav-desktop" aria-label={t('nav.label')}>
      <ul role="list">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <a class="icon-btn lang-link" href={alternateUrl(lang, Astro.url.pathname)} aria-label={t('lang.switch')} title={t('lang.switch')}>
        <Icon name="globe" />
        <span aria-hidden="true">{lang === 'fr' ? 'EN' : 'FR'}</span>
      </a>

      <button
        type="button"
        class="icon-btn"
        data-theme-toggle
        aria-label={t('theme.toggle')}
        title={t('theme.toggle')}
        aria-pressed="false"
      >
        <Icon name="sun" class="icon-sun" />
        <Icon name="moon" class="icon-moon" />
      </button>

      <button
        type="button"
        class="icon-btn menu-toggle"
        data-menu-toggle
        aria-label={t('nav.menu.open')}
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <Icon name="menu" class="icon-menu" />
        <Icon name="close" class="icon-close" />
      </button>
    </div>
  </div>

  <!-- Navigation mobile -->
  <nav id="mobile-nav" class="nav-mobile" aria-label={t('nav.label')} hidden>
    <ul role="list">
      {
        navLinks.map((link) => (
          <li>
            <a href={link.href} data-mobile-link>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script is:inline>
  (function () {
    const toggle = document.querySelector('[data-menu-toggle]');
    const nav = document.getElementById('mobile-nav');
    if (!toggle || !nav) return;

    const openLabel = toggle.getAttribute('aria-label');
    const closeLabel = nav.getAttribute('aria-label');

    function setOpen(open) {
      toggle.setAttribute('aria-expanded', String(open));
      nav.hidden = !open;
      document.body.style.overflow = open ? 'hidden' : '';
      document.documentElement.classList.toggle('menu-open', open);
    }

    toggle.addEventListener('click', function () {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      setOpen(!isOpen);
    });

    nav.querySelectorAll('[data-mobile-link]').forEach(function (link) {
      link.addEventListener('click', function () {
        setOpen(false);
      });
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4.25rem;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--text);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .logo-mark {
    display: inline-grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 9px;
    background: var(--text);
    color: var(--bg);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0;
  }
  .logo-name {
    font-size: var(--step-0);
  }

  .nav-desktop ul {
    display: flex;
    gap: 0.5rem;
  }
  .nav-desktop a {
    display: inline-block;
    padding: 0.5rem 0.65rem;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 500;
    font-size: var(--step--1);
    white-space: nowrap;
    transition: color var(--transition), background-color var(--transition);
  }
  .nav-desktop a:hover {
    color: var(--text);
    background: var(--bg-soft);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .lang-link {
    width: auto;
    gap: 0.35rem;
    padding-inline: 0.7rem;
    font-size: var(--step--1);
    font-weight: 700;
    text-decoration: none;
  }

  /* Icones theme : on affiche soleil OU lune selon le theme actif */
  .icon-sun {
    display: none;
  }
  .icon-moon {
    display: block;
  }
  :global([data-theme='dark']) .icon-sun {
    display: block;
  }
  :global([data-theme='dark']) .icon-moon {
    display: none;
  }

  /* Bouton menu : masque en desktop */
  .menu-toggle {
    display: none;
  }
  .icon-close {
    display: none;
  }
  :global(.menu-open) .menu-toggle .icon-menu {
    display: none;
  }
  :global(.menu-open) .menu-toggle .icon-close {
    display: block;
  }

  .nav-mobile {
    border-top: 1px solid var(--border);
    background: var(--bg);
  }
  .nav-mobile ul {
    display: flex;
    flex-direction: column;
    padding: 0.5rem var(--gutter) 1.25rem;
  }
  .nav-mobile a {
    display: block;
    padding: 0.9rem 0.5rem;
    color: var(--text);
    text-decoration: none;
    font-size: var(--step-1);
    font-weight: 600;
    border-bottom: 1px solid var(--border);
  }

  /* Responsive : bascule desktop/mobile
     Seuil plus large que la normale car la nav compte 7 entrees
     (Parcours / Stage / Projets / Competences / Veille / Bilan / Contact). */
  @media (max-width: 68rem) {
    .nav-desktop {
      display: none;
    }
    .menu-toggle {
      display: inline-flex;
    }
  }
  @media (max-width: 48rem) {
    .logo-name {
      display: none;
    }
  }
  @media (min-width: 68.0625rem) {
    .nav-mobile {
      display: none;
    }
  }
</style>
