---
import BaseLayout from '../layouts/BaseLayout.astro';
import { homeUrl, useTranslations } from '../i18n/utils';
import Icon from '../components/Icon.astro';

const lang = 'fr';
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title="404 — Page introuvable">
  <section class="section notfound">
    <div class="container">
      <p class="code-404" aria-hidden="true">404</p>
      <h1 class="nf-title">Page introuvable / Page not found</h1>
      <p class="nf-text">
        La page que tu cherches n'existe pas ou a ete deplacee.<br />
        The page you are looking for doesn't exist or has moved.
      </p>
      <a class="btn btn-primary" href={homeUrl(lang)}>
        <Icon name="arrowRight" />
        {t('footer.backtotop') === 'Back to top' ? 'Back home' : "Retour a l'accueil"}
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    text-align: center;
    min-height: 60vh;
    display: grid;
    place-content: center;
  }
  .code-404 {
    font-size: clamp(5rem, 3rem + 14vw, 12rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    background: linear-gradient(120deg, var(--accent), var(--text));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .nf-title {
    font-size: var(--step-2);
    margin: 0.5rem 0 1rem;
  }
  .nf-text {
    color: var(--text-muted);
    margin-bottom: 2rem;
  }
  .notfound .btn {
    margin-inline: auto;
  }
</style>
